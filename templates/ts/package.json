{
  "name": "my-connector",
  "version": "1.0.0",
  "private": true,
  "description": "Sync Vault connector (TypeScript template)",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --format=cjs --platform=neutral --target=es2020 --outfile=main.js",
    "smoke": "npm run build && node dev.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "@sync-vault/connector-sdk": "^0.2.0",
    "typescript": "^5.8.3"
  }
}
